PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shiftbooking
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
APP_NAME=Vework
VERIFY_EMAIL_REQUIRED=false

# SMTP — Namecheap Private Email: mail.privateemail.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@yourdomain.com
SMTP_PASS=
SMTP_FROM=Vework <support@yourdomain.com>
# If deploy gets ETIMEDOUT: try port 465 + SMTP_SECURE=true, or SMTP_FORCE_IPV4=true
# SMTP_FORCE_IPV4=true
# SMTP_TIMEOUT_MS=20000
# SMTP_DEBUG=false
BASE_HOURLY_RATE=14
PENALTY_PERCENTAGE=50
EMPLOYEE_PENALTY_PERCENTAGE=50